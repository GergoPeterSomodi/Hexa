; Engine configuration file.
; Pinned to Godot 4.7.2-stable (docs/roadmap/godot-port-plan.md, B12). Edit it in the editor when you can;
; the warning levels below are the GDScript rules of B3 and must stay as they are.

config_version=5

[application]

config/name="Hexa"
config/description="Hexa: Age of Discovery, Godot port"
config/version="0.3.0"
run/main_scene="res://shell/app/app.tscn"
config/features=PackedStringArray("4.7", "Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="Hexa"
config/auto_accept_quit=false
run/low_processor_mode=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://shell/ui/theme.tres"
timers/tooltip_delay_sec=0.5

[autoload]

; The two autoloads of the standard (docs/architecture/godot-architecture.md 4.4): the bus and the one door to the rules.
Events="*res://shell/autoload/events.gd"
Session="*res://shell/autoload/session.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[debug]

; 2 = error. A script with any of these is refused, so the import and the lint fail (B3).
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
