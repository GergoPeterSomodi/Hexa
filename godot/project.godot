; Engine configuration file.
; Pinned to Godot 4.7.2-stable (docs/roadmap/godot-port-plan.md, B12). Edit it in the editor when you can;
; the warning levels below are the GDScript rules of B3 and must stay as they are.

config_version=5

[application]

config/name="Hexa"
config/description="Hexa: Age of Discovery, Godot port"
config/version="0.3.0"
run/main_scene="res://shell/app/main.tscn"
config/features=PackedStringArray("4.7", "Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[debug]

; 2 = error. A script with any of these is refused, so the import and the lint fail (B3).
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/integer_division=2
gdscript/warnings/narrowing_conversion=2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
