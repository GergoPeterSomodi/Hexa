[gd_scene format=3]

[node name="Floater" type="PanelContainer"]
mouse_filter = 2
theme_type_variation = &"PanelToast"

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="Dot" type="ColorRect" parent="HBox"]
custom_minimum_size = Vector2(8, 8)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="Word" type="Label" parent="HBox"]
layout_mode = 2
theme_type_variation = &"Body"
vertical_alignment = 1
