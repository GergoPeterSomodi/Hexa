## Writes the map check report of 0.3.0 (docs/reports/0.3.0-map-check.md): every count of the Europe map beside the Python
## reference (godot/data/map_reference.json) with OK, OPEN or OUT; the open misses and their reasons; the owner of every
## land hex against Python; and the speed rows that tools/speed_probe.gd wrote (docs/reports/0.3.0-speed.json), when they
## exist. The map is the map file (the map that ships); -- --build builds it instead (CI checks that the two are equal).
## Run: godot --headless --path godot -s res://tools/map_report.gd -- --out=<absolute path of the report>
## (exit status 1 when a checked count is out of range). Without --out the report goes to docs/reports/ in the repository.
extends SceneTree

const REFERENCE := "res://data/map_reference.json"
const SPEED_JSON := "res://../docs/reports/0.3.0-speed.json"
const DEFAULT_OUT := "res://../docs/reports/0.3.0-map-check.md"
const OWNER_LIST_LIMIT := 80  # owner differences listed in full; more than this is counted only


func _init() -> void:
	var out := _argument("--out=", ProjectSettings.globalize_path(DEFAULT_OUT).simplify_path())
	var map := _map()
	if map == null:
		printerr("map report: the map file does not read")
		quit(1)
		return
	var reference: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(REFERENCE))
	var counts := MapCounts.new(map, reference)
	var rows := counts.run()
	var text := _markdown(map, rows, counts)
	var file := FileAccess.open(out, FileAccess.WRITE)
	if file == null:
		printerr("map report: cannot write %s (error %d)" % [out, FileAccess.get_open_error()])
		quit(1)
		return
	file.store_string(text)
	file.close()
	var failed := MapCounts.failures(rows)
	print("map report: wrote %s (%d count(s) out of range)" % [out, failed])
	quit(1 if failed > 0 else 0)


## The map to report: the map file, or the builder's map with -- --build.
func _map() -> MapData:
	if "--build" in OS.get_cmdline_user_args():
		return MapBuilder.build_europe(EuropeData.load_europe())
	return MapFile.from_text(FileAccess.get_file_as_string(MapFile.PATH))


func _argument(prefix: String, default_value: String) -> String:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with(prefix):
			return arg.substr(prefix.length())
	return default_value


func _markdown(map: MapData, rows: Array[MapCounts.Row], counts: MapCounts) -> String:
	var lines := PackedStringArray()
	var ok := 0
	var open := 0
	var out := 0
	for row: MapCounts.Row in rows:
		if row.group == MapCounts.GROUP_INFO:
			continue
		if row.ok:
			ok += 1
		elif row.open_note != "":
			open += 1
		else:
			out += 1
	lines.append("# Map check: Europe 1480 (release 0.3.0, item 4)")
	lines.append("")
	lines.append("Generated by `godot/tools/map_report.gd` from `godot/data/maps/europe_1480.json` (the map file that ships,")
	lines.append("seed %d). The Python reference is `godot/data/map_reference.json`, written by `tools/export_map_reference.py`" % map.map_seed)
	lines.append("from the Python game at v0.2.2 on seeds 1480 and 1 to 7. The rules are the brief's \"The new Europe is checked\".")
	lines.append("")
	lines.append("## Summary")
	lines.append("")
	lines.append("- Checked rows: %d. OK: %d. OPEN (a miss the systems designer must accept or fix): %d. OUT: %d." % [
			ok + open + out, ok, open, out])
	lines.append("- Owners: %d of %d land hexes (%.2f percent) have Python's owner; the rule is at least %.0f percent."
			% [counts.owner_same, counts.owner_land, 100.0 * float(counts.owner_same) / float(maxi(counts.owner_land, 1)),
			100.0 * MapCounts.OWNER_AGREEMENT])
	var verdict := "PASS" if out == 0 else "FAIL"
	if out == 0 and open > 0:
		verdict = "PASS, with %d open %s" % [open, "miss" if open == 1 else "misses"]
	lines.append("- Verdict: **%s**." % verdict)
	lines.append("")
	lines.append("## Every count")
	lines.append("")
	var group := ""
	for row: MapCounts.Row in rows:
		if row.group != group:
			group = row.group
			lines.append("")
			lines.append("### %s" % _group_title(group))
			lines.append("")
			lines.append("| Count | Godot | Python (reference) | Status |")
			lines.append("| --- | --- | --- | --- |")
		lines.append("| %s | %s | %s | %s |" % [_cell(row.label), _cell(row.godot), _cell(row.reference), _status(row)])
	lines.append("")
	lines.append("## Open misses")
	lines.append("")
	var any_open := false
	for row: MapCounts.Row in rows:
		if not row.ok and row.open_note != "":
			any_open = true
			lines.append("- **%s**: Godot %s; Python %s. %s." % [row.label, row.godot, row.reference, row.open_note])
	if not any_open:
		lines.append("None.")
	lines.append("")
	lines.append("## Owners against Python")
	lines.append("")
	lines.append("Each land hex is compared with the owner Python gives it on seed 1480. The rule is at least %.0f percent" %
			(100.0 * MapCounts.OWNER_AGREEMENT) + " of the land hexes; the list below is every difference.")
	lines.append("")
	lines.append("- Same owner: %d of %d land hexes (%.2f percent)." % [counts.owner_same, counts.owner_land,
			100.0 * float(counts.owner_same) / float(maxi(counts.owner_land, 1))])
	lines.append("- Different owner: %d." % counts.owner_misses.size())
	if counts.owner_misses.size() > 0 and counts.owner_misses.size() <= OWNER_LIST_LIMIT:
		lines.append("")
		for miss: String in counts.owner_misses:
			lines.append("  - %s" % miss)
	elif counts.owner_misses.size() > OWNER_LIST_LIMIT:
		lines.append("- The list is longer than %d and is not printed; the counts above hold." % OWNER_LIST_LIMIT)
	lines.append("")
	lines.append("## Speed")
	lines.append("")
	lines.append(_speed_section())
	lines.append("")
	return "\n".join(lines)


func _speed_section() -> String:
	var raw: Variant = JSON.parse_string(FileAccess.get_file_as_string(SPEED_JSON)) if FileAccess.file_exists(SPEED_JSON) else null
	if typeof(raw) != TYPE_DICTIONARY:
		return "Not measured in this run. `godot/tools/speed_probe.gd` writes the table to `docs/reports/0.3.0-speed.json`."
	var speed: Dictionary = raw
	var lines := PackedStringArray()
	lines.append("Measured by `godot/tools/speed_probe.gd` on %s. %s" % [speed.get("machine", "this machine"),
			speed.get("note", "")])
	lines.append("")
	lines.append("| Measure | Time | Note |")
	lines.append("| --- | --- | --- |")
	for item: Variant in speed["rows"]:
		var row: Array = item
		lines.append("| %s | %s | %s |" % [_cell(str(row[0])), _cell(str(row[1])), _cell(str(row[2]))])
	return "\n".join(lines)


static func _status(row: MapCounts.Row) -> String:
	if row.group == MapCounts.GROUP_INFO:
		return "info"
	if row.ok:
		return "OK"
	if row.open_note != "":
		return "OPEN"
	return "OUT"


static func _group_title(group: String) -> String:
	if group == MapCounts.GROUP_EQUAL:
		return "Must be equal"
	if group == MapCounts.GROUP_CLOSE:
		return "Must be close (luck moves them in Python too)"
	return "For information"


static func _cell(text: String) -> String:
	return text.replace("|", "/")
