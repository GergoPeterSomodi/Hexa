## Writes shell/panels/tile_tabs/tile_tabs_index.gd: the list of the tab scripts (`*_tab.gd`) in the tile_tabs folder
## (tile-window spec D4). TileTabs reads that index for the real folder, because the folder listing may miss scripts in an
## exported build. Run after adding or removing a tab, and commit the file.
##
## Run (from the repository root):
##   "$GODOT" --headless --path godot -s res://tools/build_tile_tabs.gd              writes the index
##   "$GODOT" --headless --path godot -s res://tools/build_tile_tabs.gd -- --check   verifies the committed index (CI)
extends SceneTree

const OUT := "res://shell/panels/tile_tabs/tile_tabs_index.gd"
const HEADER := "# GENERATED by godot/tools/build_tile_tabs.gd from this folder (tile-window spec D4). Do not edit: run the tool and commit."


func _initialize() -> void:
	var check := OS.get_cmdline_user_args().has("--check")
	var text := render(TileTabs.list_folder(TileTabs.FOLDER))
	if check:
		var committed := FileAccess.get_file_as_string(OUT)
		if committed != text:
			printerr("build_tile_tabs: %s is stale: run tools/build_tile_tabs.gd and commit it" % OUT)
			quit(1)
			return
		print("build_tile_tabs: %s is current (%d tabs)" % [OUT, TileTabs.list_folder(TileTabs.FOLDER).size()])
		quit(0)
		return
	var file := FileAccess.open(OUT, FileAccess.WRITE)
	if file == null:
		printerr("build_tile_tabs: cannot write %s" % OUT)
		quit(1)
		return
	file.store_string(text)
	print("build_tile_tabs: wrote %s (%d tabs)" % [OUT, TileTabs.list_folder(TileTabs.FOLDER).size()])
	quit(0)


## The text of the index for a list of tab paths (sorted by the caller's listing).
static func render(paths: PackedStringArray) -> String:
	var lines: PackedStringArray = [HEADER, "extends RefCounted", ""]
	if paths.is_empty():
		lines.append("const PATHS: PackedStringArray = []")
	else:
		lines.append("const PATHS: PackedStringArray = [")
		for path: String in paths:
			lines.append("\t\"%s\"," % path)
		lines.append("]")
	return "\n".join(lines) + "\n"
